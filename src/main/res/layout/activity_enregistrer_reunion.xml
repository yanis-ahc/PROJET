<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
      >

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/textView20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enregistrer des Reunions" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textViewdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="date" />

            <EditText
                android:id="@+id/editTextdate"
                android:layout_width="213dp"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textViewheure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="heure" />

            <EditText
                android:id="@+id/editTextheure"
                android:layout_width="226dp"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textViewsalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="salle" />

            <EditText
                android:id="@+id/editTextsalle"
                android:layout_width="227dp"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textViewtype"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="type" />

        <RadioButton
            android:id="@+id/radioButtonequipe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Réunion d'équipe" />

        <RadioButton
            android:id="@+id/radioButtonresponsable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Réunion avec le responsable" />


    </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>